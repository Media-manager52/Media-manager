POSTGRES_DB=media_manager
POSTGRES_USER=media_manager
POSTGRES_PASSWORD=replace-with-a-long-random-password
MEDIA_MANAGER_VERSION=replace-with-release-version
MEDIA_MANAGER_COMMIT=replace-with-git-commit
# Pin the Compose project name so the Cosmos route targets
# media-manager-api-1 and media-manager-ui-1 stay valid.
COMPOSE_PROJECT_NAME=media-manager
# Server-side bearer used by the API owner handlers. Cosmos Cloud's /api route
# injects it; it is never exposed to browser JavaScript.
OWNER_TOKEN=replace-with-at-least-32-random-characters

# Loopback-only direct API. Cosmos resolves the API container directly; this
# port is for local acceptance clients and machine checks. Never bind it to a
# LAN or public address.
MEDIA_MANAGER_API_PORT=28081
COMMISSIONING_V2_OWNER_ORIGIN=http://127.0.0.1:28081

# Shared network with AltMount, Plex and Seerr. Use the network your Cosmos
# applications already use (the production stack uses media-stack).
MEDIA_NETWORK=media-manager
MEDIA_MANAGER_UID=65532
MEDIA_MANAGER_GID=65532

# Host directory that CONTAINS AltMount's FUSE mount point; it is mounted
# read-only at /mnt in the API with rslave propagation, so an AltMount restart
# or FUSE remount reaches the API without recreating it. With the FUSE at
# /mnt/altmount the AltMount client's local_read_only_root is /mnt/altmount;
# Plex must see the mount at that same absolute path (symlink targets).
ALTMOUNT_HOST_PARENT_PATH=/mnt

# Writable Plex library roots on the Docker host.
MOVIES_HOST_PATH=/srv/media/movies
TV_HOST_PATH=/srv/media/tv

# Optional: parent of additional Plex library folders used by Seerr root-folder
# routing (one library root per folder). Leave the default when unused.
# MEDIA_LIBRARY_GID is the host group that owns those folders.
MEDIA_LIBRARY_HOST_PATH=/srv/media
MEDIA_LIBRARY_GID=1001

# Optional existing provider-secret files. Leaving these blank keeps each
# provider unconfigured through the Compose /dev/null default.
METADATA_TMDB_TOKEN_SOURCE_FILE=
METADATA_TVDB_KEY_SOURCE_FILE=
METADATA_SIMKL_CLIENT_ID_SOURCE_FILE=

# Optional Seerr intake. Keep blank until configured in Seerr.
SEERR_BASE_URL=
SEERR_API_KEY=
SEERR_INSTANCE_ID=
SEERR_WEBHOOK_SECRET=
SEERR_ALLOW_HTTP=false

# Optional Radarr/Sonarr-compatible API for Seerr. When set, Seerr can point its
# Radarr/Sonarr services at http://media-manager-api-1:8080/radarr and /sonarr
# with this value as the API key, and the *arr applications are not needed.
SERVARR_API_KEY=
