POSTGRES_DB=media_manager
POSTGRES_USER=media_manager
POSTGRES_PASSWORD=replace-with-a-long-random-password
MEDIA_MANAGER_VERSION=replace-with-release-version
MEDIA_MANAGER_COMMIT=replace-with-git-commit
# Server-side bearer used by the API owner handlers and injected by the Cosmos
# /api route. It is never exposed to browser JavaScript.
OWNER_TOKEN=replace-with-at-least-32-random-characters

# Loopback-only direct API. Cosmos Cloud resolves the API container directly;
# this port is for local acceptance clients and machine checks. Never bind it to
# a LAN or public address.
MEDIA_MANAGER_API_PORT=28081
COMMISSIONING_V2_OWNER_ORIGIN=http://127.0.0.1:28081

MEDIA_NETWORK=media-manager
MEDIA_MANAGER_UID=65532
MEDIA_MANAGER_GID=65532

# Read-only AltMount source and writable Plex library roots on the Docker host.
ALTMOUNT_HOST_PATH=/srv/altmount/complete
MOVIES_HOST_PATH=/srv/media/movies
TV_HOST_PATH=/srv/media/tv

# Optional existing provider-secret files. Leaving these blank keeps each
# provider unconfigured through the Compose /dev/null default.
METADATA_TMDB_TOKEN_SOURCE_FILE=
METADATA_TVDB_KEY_SOURCE_FILE=
METADATA_SIMKL_CLIENT_ID_SOURCE_FILE=

# Optional Seerr intake. Keep blank until configured in Seerr.
SEERR_BASE_URL=
SEERR_API_KEY=
SEERR_INSTANCE_ID=
SEERR_WEBHOOK_SECRET=
SEERR_ALLOW_HTTP=false
