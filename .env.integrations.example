# Copy this file to .env.integrations. It is loaded only into the API container.
# Each name may be used as an integration's secret_ref.

ALTMOUNT_SECRET=replace-with-a-unique-private-value
PLEX_TOKEN=replace-me
NEWZNAB_PRIMARY_API_KEY=replace-me
NEWZNAB_SECONDARY_API_KEY=replace-me

# Optional dedicated Media Manager metadata-provider credentials. Never copy
# these from another application. TVDB may require a subscriber PIN depending
# on the provider license. Simkl needs only its application Client ID.
TMDB_ACCESS_TOKEN=replace-me
TVDB_API_KEY=replace-me
TVDB_SUBSCRIBER_PIN=
SIMKL_CLIENT_ID=replace-me

# Server-generated 32-byte key, encoded as 64 hexadecimal characters. API only.
# Protect and back this up with the encrypted credential database; do not rotate
# it independently after saving credentials. OldBoys setup is disabled if empty.
OLDBOYS_CREDENTIAL_ENCRYPTION_KEY=

# Optional off-site copy of the encrypted, restore-verified application backup.
# Kind is "s3" or "webdav"; leave it empty to disable. The destination receives
# only the encrypted .mmbackup artifact, never a plaintext dump.
BACKUP_OFFSITE_KIND=
BACKUP_OFFSITE_PREFIX=media-manager/backups
# S3-compatible storage (path-style). Use *_FILE names for Docker secrets.
BACKUP_OFFSITE_S3_ENDPOINT=
BACKUP_OFFSITE_S3_REGION=
BACKUP_OFFSITE_S3_BUCKET=
BACKUP_OFFSITE_S3_ACCESS_KEY=
BACKUP_OFFSITE_S3_SECRET_KEY=
# WebDAV collection. The folder path below the URL is created when missing.
BACKUP_OFFSITE_WEBDAV_URL=
BACKUP_OFFSITE_WEBDAV_USERNAME=
BACKUP_OFFSITE_WEBDAV_PASSWORD=
# Only for a private test server. Production S3/WebDAV endpoints must use HTTPS.
BACKUP_OFFSITE_ALLOW_HTTP=false

# Encrypted application backups. Generate with: openssl rand -base64 32
# Back this up separately; without it encrypted backups cannot be restored.
BACKUP_ENCRYPTION_KEY=
