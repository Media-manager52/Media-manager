@@ -71,7 +71,12 @@ func statIDsWithBoundedRetries(
 
 	sweepStart := time.Now()
 	for attempt := 1; len(remaining) > 0; attempt++ {
-		statCtx, cancel := context.WithTimeout(ctx, pool.StatManyTimeout(len(remaining), maxConnections, timeout))
+		// Bound the actual requests as well as retry backoff. Otherwise a
+		// single slow attempt can exceed the entire sweep budget. Give the
+		// pool time to fail over instead of restarting a two-second window
+		// against the same slow provider on every retry.
+		attemptTimeout := min(pool.StatManyTimeout(len(remaining), maxConnections, timeout), fastFailStatBudget-time.Since(sweepStart))
+		statCtx, cancel := context.WithTimeout(ctx, attemptTimeout)
 		reported := make(map[string]bool, len(remaining))
 		transient := make(map[string]error, len(remaining))
 		definitive := 0
diff --git a/internal/importer/validation/fast_fail_deadline_test.go b/internal/importer/validation/fast_fail_deadline_test.go
