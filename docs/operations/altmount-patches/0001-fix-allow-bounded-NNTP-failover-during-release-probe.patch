@@ -0,0 +1,35 @@
+package validation
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/kipsilabs/altmount/internal/testsupport/fakepool"
+)
+
+func TestReleaseProbeAllowsProviderFallbackBeyondTwoSeconds(t *testing.T) {
+	client := fakepool.New()
+	client.SetDefaultBehavior(fakepool.SegmentBehavior{Latency: 2250 * time.Millisecond})
+	verdict, err := FastFailReleaseProbeVerdict(t.Context(), probeFile(8), fastFailPoolManager{client: client}, 100, 8, 30*time.Second, nil, time.Time{})
+	if err != nil || verdict.Missing || verdict.Dead {
+		t.Fatalf("reachable articles after slow provider fallback: verdict=%+v error=%v", verdict, err)
+	}
+}
+
+func TestFastFailSweepDeadlineHonorsTotalBudget(t *testing.T) {
+	previous := fastFailStatBudget
+	fastFailStatBudget = 100 * time.Millisecond
+	t.Cleanup(func() { fastFailStatBudget = previous })
+	client := fakepool.New()
+	client.SetDefaultBehavior(fakepool.SegmentBehavior{Latency: 2 * time.Second})
+	start := time.Now()
+	missing, unverified, err := statIDsWithBoundedRetries(t.Context(), client, []string{"slow"}, 1, 30*time.Second, false, nil, time.Time{})
+	if !errors.Is(err, ErrFastFailInconclusive) || !errors.Is(err, context.DeadlineExceeded) || len(missing) != 0 || len(unverified) != 1 {
+		t.Fatalf("missing=%v unverified=%v error=%v", missing, unverified, err)
+	}
+	if elapsed := time.Since(start); elapsed > time.Second {
+		t.Fatalf("sweep took %v with a 100ms budget", elapsed)
+	}
+}
